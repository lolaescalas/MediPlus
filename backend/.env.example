# ══════════════════════════════════════════════════════════════
#  .env.example  —  Copiá este archivo a .env y completá los valores
#  ⚠️  NUNCA commitear el .env real al repositorio
# ══════════════════════════════════════════════════════════════

# ── MongoDB Atlas ─────────────────────────────────────────────
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/
# Obtenerlo en: Atlas → tu cluster → Connect → Drivers
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.XXXXX.mongodb.net/

# Nombre de la base de datos a usar
MONGO_DB_NAME=nombre_de_tu_bd

# ── Neo4j Aura ────────────────────────────────────────────────
# Formato: neo4j+s://<id>.databases.neo4j.io
# Obtenerlo en: Aura Console → tu instancia → Connection URI
NEO4J_URI=neo4j+s://XXXXXXXX.databases.neo4j.io

# Usuario (generalmente "neo4j")
NEO4J_USER=neo4j

# Contraseña generada al crear la instancia en Aura
NEO4J_PASSWORD=tu_password_aura

# ── API (opcional) ────────────────────────────────────────────
API_HOST=localhost
API_PORT=8000
